// Cloudflare Workers settings (see docs/deploy.md). Secrets are set with `wrangler secret put`.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "akmeiir-quiz",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Pages make several database queries, so run next to the Turso database rather than next
	// to each visitor.
	"placement": { "mode": "smart" },
	// Request logs with CPU time, to check password hashing stays under the free plan's 10 ms.
	"observability": { "enabled": true }
}
