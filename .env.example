# Local development. Production values are Cloudflare secrets (see docs/deploy.md).

# A local SQLite file; no token needed. For Turso: libsql://… plus its token.
DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

# The address the app is served from.
ORIGIN="http://localhost:5173"

# Better Auth: 32+ random characters, e.g. `openssl rand -base64 32`.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
